{
  "name": "document-editor-vanilla",
  "version": "0.1.2",
  "description": "OOXML-native document editor core library (vanilla JS/TS)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./styles": "./dist/styles.css",
    "./vite": {
      "import": "./dist/vite-plugin.js",
      "types": "./dist/vite-plugin.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "BUILD_MODE=lib tsc -p tsconfig.lib.json && BUILD_MODE=lib vite build && tsc -p tsconfig.plugin.json",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "lucide": "^0.577.0",
    "tailwindcss": "^4.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "document-editor",
    "ooxml",
    "docx",
    "wasm",
    "word-processor"
  ],
  "license": "Apache-2.0"
}
