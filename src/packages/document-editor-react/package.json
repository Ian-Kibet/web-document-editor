{
  "name": "document-editor-react",
  "version": "0.1.0",
  "description": "React component wrapper for document-editor-vanilla",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
